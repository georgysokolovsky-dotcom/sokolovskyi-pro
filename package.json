{
  "name": "pro-muzhchin-site-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:astro": "astro dev",
    "build:astro": "astro build",
    "preview:astro": "astro preview",
    "baseline": "node scripts/create-migration-baseline.mjs",
    "migrate:articles": "node scripts/migrate-articles-to-astro.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify:migration": "node scripts/verify-content-migration.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:seo": "node scripts/compare-astro-baseline.mjs && node scripts/check-seo-architecture.mjs",
    "dev:legacy": "vite",
    "build:legacy": "vite build",
    "preview:legacy": "vite preview",
    "dev:drafts": "node scripts/dev-drafts.mjs",
    "test:site": "node --test scripts/tests/*.test.mjs",
    "check:seo-architecture": "node scripts/check-seo-architecture.mjs",
    "check:release": "npm run validate:content && npm run test:site && npm run build:astro && npm run check:links && npm run check:routes && npm run check:public-boundary && npm run check:seo-architecture && npm run check:built-content",
    "check:built-content": "node scripts/check-built-content.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "astro": "^6.4.8",
    "yaml": "^2.9.0"
  }
}
