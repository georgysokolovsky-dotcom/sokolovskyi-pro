---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageIntro from '../components/PageIntro.astro';
import { legalPages, legalStatus } from '../data/legal.js';
import { absoluteUrl } from '../lib/site-routes.js';
import { robotsForPage } from '../lib/seo.js';

export function getStaticPaths() {
  return Object.entries(legalPages).map(([page, data]) => ({ params: { legal: page }, props: { data } }));
}

const { legal } = Astro.params;
const { data } = Astro.props;
const breadcrumbItems = [{ label: 'Документы', href: '/editorial-policy/' }, { label: data.title }];
---
<BaseLayout title={`${data.title} — PRO Мужчин`} description={data.description} canonical={absoluteUrl(`/${legal}/`)} robots={robotsForPage({ legalStatus })}>
  <Header />
  <main>
    <PageIntro breadcrumbs={breadcrumbItems} title={data.title} lead={data.description} />
    <article class="visitor-information shell section-space">
      {data.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      {data.showCookieSettings && <button class="button button--accent" type="button" data-open-cookie-settings>Настройки cookie</button>}
      <nav class="visitor-information__links" aria-label="Связанные страницы">
        {data.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .visitor-information { max-width: 860px; }
  .visitor-information section + section { margin-top: 40px; }
  .visitor-information h2 { margin: 0 0 16px; font-size: clamp(26px, 3vw, 36px); line-height: 1.2; }
  .visitor-information p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.72; }
  .visitor-information p + p { margin-top: 14px; }
  .visitor-information .button { margin-top: 32px; }
  .visitor-information__links { display: flex; flex-wrap: wrap; gap: 16px 24px; margin-top: 32px; }
  .visitor-information__links a { color: var(--accent-dark); text-underline-offset: 3px; }
  @media (max-width: 720px) {
    :global(.page-intro h1) { overflow-wrap: anywhere; }
    .visitor-information p { font-size: 15px; }
  }
</style>
