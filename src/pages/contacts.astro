---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageIntro from '../components/PageIntro.astro';
import ArticleCta from '../components/ArticleCta.astro';
import { pageMeta } from '../data/pages.js';
import { absoluteUrl } from '../lib/site-routes.js';
import { buildBreadcrumbJsonLd } from '../lib/seo.js';

const breadcrumbItems = [{ label: 'Контакты' }];
const meta = pageMeta.contacts;
---
<BaseLayout title={meta.title} description={meta.description} canonical={absoluteUrl('/contacts/')} jsonLd={[buildBreadcrumbJsonLd(breadcrumbItems)]}>
  <Header />
  <main>
    <PageIntro breadcrumbs={breadcrumbItems} title="Контакты" lead="Начни с бесплатного вебинара о состоянии, личных границах и решениях в кризисе отношений." />
    <section class="contact-section shell section-space">
      <div><p class="section-label">Следующий шаг</p><h2>Бесплатный вебинар</h2><p>Кнопка откроет страницу бесплатного вебинара. На ней можно ознакомиться с описанием и перейти к регистрации в Telegram.</p><ArticleCta placement="contacts" articleId="contacts" topic="overview">Перейти к бесплатному вебинару</ArticleCta></div>
      <div class="contact-note"><span>Важно</span><p>На этом этапе сайт не собирает собственные заявки и не просит вводить здесь имя, телефон или почту.</p></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
