---
import type { MarkdownInstance } from 'astro';
import ServiceLegalLayout from '../../layouts/ServiceLegalLayout.astro';
import { loadServiceLegalBundle } from '../../data/service-legal.js';

export function getStaticPaths() {
  const bundle = loadServiceLegalBundle();
  return bundle.documents.map((document) => ({
    params: { document: document.id },
    props: {
      document,
      mode: bundle.mode,
      effectiveFrom: bundle.release?.effectiveFrom ?? null,
      myTermsUrl: bundle.release?.publication.myTermsUrl ?? null,
    },
  }));
}

const { document, mode, effectiveFrom, myTermsUrl } = Astro.props;
const sources = import.meta.glob<MarkdownInstance<{ title: string; version: string }>>(
  '../../content/service-legal/*.md',
);
const loadDocument = sources['../../content/service-legal/' + document.id + '.md'];
if (!loadDocument) throw new Error('Не найден Markdown юридического документа: ' + document.id);
const { Content } = await loadDocument();
---
<ServiceLegalLayout document={document} mode={mode} effectiveFrom={effectiveFrom} myTermsUrl={myTermsUrl}>
  <Content />
</ServiceLegalLayout>
