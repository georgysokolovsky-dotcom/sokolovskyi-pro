---
import { loadServiceLegalBundle } from '../data/service-legal.js';
import { legalPages, legalStatus } from '../data/legal.js';

const serviceBundle = loadServiceLegalBundle();
const serviceLinks = serviceBundle.mode === 'published' ? serviceBundle.documents : [];
const establishedLegalLinks = legalStatus === 'approved' ? Object.entries(legalPages) : [];
---
<footer class="site-footer">
  <div class="shell site-footer__inner">
    <a class="brand-mark" href="/">PRO Мужчин</a>
    <nav class="site-footer__links" aria-label="Дополнительная навигация">
      <a href="/contacts/">Контакты</a>
      <a href="/privacy-policy/">Политика конфиденциальности</a>
      {establishedLegalLinks.map(([path, document]) => <a href={'/' + path + '/'}>{document.title}</a>)}
      {serviceLinks.map((document) => <a href={document.path}>{document.label}</a>)}
    </nav>
    <p class="site-footer__note">Материалы сайта помогают разобраться в ситуации. Они не заменяют медицинскую, юридическую или экстренную помощь.</p>
  </div>
</footer>
