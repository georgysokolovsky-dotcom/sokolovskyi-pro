---
import Analytics from '../components/Analytics.astro';
import { pageContext } from '../lib/page-context.js';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

const {
  title = 'PRO Мужчин',
  description = 'PRO Мужчин — авторский ресурс для мужчин в кризисе отношений.',
  canonical = null,
  robots = 'index, follow',
  ogType = 'website',
  ogImage,
  ogImageAlt,
  jsonLd = [],
  context = {},
} = Astro.props;
const page = pageContext(Astro.url.pathname, context);
const analyticsEnabled = import.meta.env.PROD && !import.meta.env.DRAFT_PREVIEW;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead title={title} description={description} canonical={canonical} robots={robots} ogType={ogType} ogImage={ogImage} ogImageAlt={ogImageAlt} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body data-page-path={Astro.url.pathname} data-page-id={page.page_id} data-page-type={page.page_type} data-article-id={page.article_id} data-topic={page.topic} data-analytics-enabled={String(analyticsEnabled)}>
    <slot />
    <Analytics />
  </body>
</html>
