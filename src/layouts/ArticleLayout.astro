---
import BaseLayout from './BaseLayout.astro';
import ArticleCta from '../components/ArticleCta.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { authors } from '../data/authors.js';
import { readingMinutes, summaryItems } from '../lib/content-presentation.js';
import { getTopicFromArticle, absoluteUrl, topicPath } from '../lib/site-routes.js';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, articleSocialImage } from '../lib/seo.js';

const { entry, Content, headings = [], relatedArticles = [], preview = false } = Astro.props;
const { title, description, slug, author, datePublished, dateModified, topic: topicId, search_intent: searchIntent } = entry.data;
const topic = getTopicFromArticle(entry);
const canonical = absoluteUrl(`/articles/${slug}/`);
const breadcrumbItems = [
  { label: 'Статьи', href: '/articles/' },
  { label: topic?.label ?? 'Материал', href: topic ? topicPath(topic.id) : undefined },
  { label: title },
];
const { items: summary, showGenerated: showGeneratedSummary } = summaryItems(entry.body, headings);
const minutes = readingMinutes(entry.body);
const context = { article_id: entry.data.article_id ?? slug, page_id: slug, page_type: 'article', topic: topicId };
Astro.locals.pageContext = context;
const authorRecord = authors[author];
const jsonLd = [
  buildArticleJsonLd(entry, topic),
  buildBreadcrumbJsonLd(breadcrumbItems),
];
---
<BaseLayout title={`${title} — PRO Мужчин`} description={description} canonical={preview ? null : canonical} robots={preview ? 'noindex, nofollow' : 'index, follow'} context={context} ogType="article" ogImage={articleSocialImage(entry)} ogImageAlt={title} jsonLd={preview ? [] : jsonLd}>
  <Header articleId={context.article_id} topic={topicId} searchIntent={searchIntent} />
  <main class="article-page" data-article-slug={slug}>
    {preview && <div class="draft-notice shell">Локальный черновик. Материал не опубликован. <a href="/__drafts/">Все черновики</a></div>}
    <div class="shell article-layout">
      <article class="article-content">
        <Breadcrumbs items={breadcrumbItems} />
        <h1>{title}</h1>
        <ArticleMeta author={authorRecord.name} authorUrl={authorRecord.url} datePublished={datePublished} dateModified={dateModified} readingMinutes={minutes} />
        {showGeneratedSummary && <div class="article-summary" aria-label="Краткое содержание">
          <strong>В статье:</strong>
          {summary.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
        </div>}
        <div class="article-prose"><Content /></div>
        <ArticleCta articleId={entry.data.article_id ?? slug} topic={topicId} searchIntent={searchIntent} placement="article_end">{entry.data.cta.label}</ArticleCta>
        <AuthorBio author={authorRecord} />
      </article>
      {showGeneratedSummary && summary.length > 0 && <aside class="article-aside">
        <p class="aside-title">В этой статье</p>
        <nav aria-label="Разделы статьи">{summary.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
        <div class="aside-note"><span>01</span><p>Читай в своём темпе. Тебе не нужно принять решение за один вечер.</p></div>
      </aside>}
    </div>

    <RelatedArticles articles={relatedArticles} />
  </main>
  <Footer />
</BaseLayout>
