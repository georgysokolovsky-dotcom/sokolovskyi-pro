---
import BaseLayout from '../../../../src/layouts/BaseLayout.astro';
import Header from '../../../../src/components/Header.astro';
import Footer from '../../../../src/components/Footer.astro';
import PageIntro from '../../../../src/components/PageIntro.astro';
import { menWebinarFunnel } from '../data/men-webinar-v1.js';
import { buildBreadcrumbJsonLd } from '../../../../src/lib/seo.js';

const apiOrigin = import.meta.env.PUBLIC_FUNNEL_API_ORIGIN ?? '';
const breadcrumbItems = [{ label: 'Видеоразбор' }];
---
<BaseLayout
  title="Видеоразбор — PRO Мужчин"
  description="Видеоразбор для мужчин в кризисе отношений."
  robots="noindex, nofollow"
  jsonLd={[buildBreadcrumbJsonLd(breadcrumbItems)]}
>
  <Header />
  <main class="video-funnel-page" data-api-origin={apiOrigin}>
    <PageIntro breadcrumbs={breadcrumbItems} title="Видеоразбор" lead="Страница открывается по персональной ссылке из Telegram." />
    <section class="video-funnel-shell shell section-space" aria-live="polite">
      <div class="video-funnel-status" data-video-status>
        <p class="section-label">Проверка доступа</p>
        <h2>Подготавливаем видеоразбор</h2>
        <p>Ссылка действует ограниченное время и предназначена для одного участника воронки.</p>
      </div>
      <div class="video-funnel-player" data-video-player hidden>
        <div class="video-funnel-player__placeholder">
          <span aria-hidden="true">▷</span>
          <p>Видео подключается отдельным провайдером после технического анализа.</p>
        </div>
      </div>
      <div class="video-funnel-cta" data-video-cta hidden>
        <p class="section-label">Следующий шаг</p>
        <h2>Если хочешь разобрать свою ситуацию глубже</h2>
        <a class="button button--accent" href={menWebinarFunnel.applicationReference} data-application-link>Начать заявку</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ apiOrigin }}>
  const token = new URLSearchParams(window.location.search).get('t');
  const origin = apiOrigin.replace(/\/$/, '');
  const status = document.querySelector('[data-video-status]');
  if (origin && token) {
    window.location.replace(`${origin}/webinar/lab-men-funnel-video-fixture?t=${encodeURIComponent(token)}`);
  } else if (status) {
    status.innerHTML = '<p class="section-label">Видеоразбор</p><h2>Нужна персональная ссылка из Telegram</h2>';
  }
</script>
